  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ClayMirrorPlacementController – place the bench (drag + height)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject benchGrab {"hint":"Authored child holding the bench-top grab collider (built at runtime)"}'
    - '// @input SceneObject benchVisual {"hint":"Authored child the bench visual is built under"}'
    - '// @input Asset.Material litMaterial {"hint":"Lit material (PBR) for the wood"}'
    - '// @input Asset.Material unlitMaterial {"hint":"Unlit material for the soft placement outline"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float eyeHeightCm = 150 {"hint":"Assumed eye height above the floor (cm) — sets where the floor is", "widget":"slider", "min":100, "max":190, "step":1}'
    - '// @input float defaultHeightCm = 75 {"hint":"Starting bench-top height above the floor (cm)", "widget":"slider", "min":55, "max":110, "step":1}'
    - '// @input float minHeightCm = 55 {"hint":"Lowest bench height on the slider (cm) — seated", "widget":"slider", "min":40, "max":80, "step":1}'
    - '// @input float maxHeightCm = 110 {"hint":"Highest bench height on the slider (cm) — tall standing", "widget":"slider", "min":80, "max":130, "step":1}'
    - "// @input float frontEdgeDistanceCm = 40 {\"hint\":\"Distance from the user to the bench's front edge at start (cm)\", \"widget\":\"slider\", \"min\":20, \"max\":80, \"step\":1}"
    - '// @input float benchWidthCm = 100 {"hint":"Bench width (cm)", "widget":"slider", "min":60, "max":140, "step":1}'
    - '// @input float benchDepthCm = 60 {"hint":"Bench depth (cm)", "widget":"slider", "min":40, "max":90, "step":1}'
    - '// @input vec4 woodColor = "{0.86,0.70,0.52,1}" {"hint":"Bench wood color (light oak reads best on the additive display)", "widget":"color"}'
