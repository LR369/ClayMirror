    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec4 clayColor = "{0.93,0.66,0.50,1}" {"hint":"Clay color (keep it light — the display is additive)", "widget":"color"}'
    - '// @input vec4 ringColor = "{0.55,1.0,0.65,0.55}" {"hint":"Pinch ring color while aiming", "widget":"color"}'
    - '// @input float ringPinchBoost = 1.8 {"hint":"Ring brightness multiplier while pinching", "widget":"slider", "min":1, "max":3, "step":0.1}'
    - '// @input float dropRadiusCm = 18 {"hint":"Release the block within this horizontal distance of the wheel center to land it (cm)", "widget":"slider", "min":8, "max":30, "step":1}'
