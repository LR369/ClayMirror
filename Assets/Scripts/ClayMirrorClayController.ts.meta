  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ClayMirrorClayController – drop, sculpt, collapse, undo</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input AssignableType_1 wheel {\"hint\":\"The potter's wheel (spin angle + state)\"}"
    - '// @input SceneObject restAnchor {"hint":"Where the fresh block rests on the bench beside the wheel"}'
    - '// @input SceneObject clayAnchor {"hint":"Top-center of the wheel head; the clay snaps here when dropped"}'
